# String de conexão do PostgreSQL 16 + pgvector (container willen_postgres)
DATABASE_URL="postgresql://willen:willen@localhost:5432/willen?schema=public"

# URL do Elasticsearch 9.5 (container willen_elasticsearch)
ELASTICSEARCH_URL="http://localhost:9200"

# Chave de API do Google Gemini (obrigatória para embeddings gemini-embedding-001 e geração RAG)
GEMINI_API_KEY="PREENCHA_SUA_GEMINI_API_KEY_AQUI"
GEMINI_MODEL="gemini-3.5-flash"

# Porta do servidor HTTP Express (padrão: 3000)
PORT=3000

